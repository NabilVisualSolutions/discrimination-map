# Copy to .env (gitignored, never commit the real values).

# Bearer token for /admin and /api/admin/* — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset = admin routes disabled entirely (fails closed, not open).
DXMAP_ADMIN_TOKEN=

# Optional. YouTube Data API key — free tier, widens source coverage.
# YOUTUBE_API_KEY=

# Optional. Reddit OAuth app credentials (free) — see backend/agent.py.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
