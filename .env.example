# Copy to .env (gitignored, never commit the real values).

# --- Admin bootstrap ---
# Creates the first ADMIN account on startup if no users exist yet. Set once,
# then you can remove these — subsequent logins use the password you set.
DXMAP_ADMIN_EMAIL=
DXMAP_ADMIN_PASSWORD=

# --- Environment ---
# Set to "prod" on the VPS. Also flips the session cookie to Secure-only and
# activates the CORS wildcard self-check below.
DXMAP_ENV=dev

# CORS allow-list, comma-separated. Defaults to "*" (any origin) if unset —
# fine for local dev, must be your real domain in prod (e.g.
# https://map.nabilvs.com). backend/selfcheck.py flags this if left wildcard
# while DXMAP_ENV=prod.
# DXMAP_ALLOW_ORIGINS=https://map.nabilvs.com

# --- Storage ---
# DXMAP_DB_PATH=backend/dxmap.db

# --- Scraping agent (backend/agent.py) ---
# Bluesky + Mastodon work with zero configuration — free, keyless, confirmed
# working from a datacenter IP. Reddit's anonymous .json endpoints are
# blocked on cloud IPs as of this build, so it's not wired in by default.
# DXMAP_HEARTBEAT_SECONDS=180
# DXMAP_GEOCODE_BUDGET=6
# DXMAP_TERMS=<comma-separated German far-right search terms>
# DXMAP_MASTODON_INSTANCES=mastodon.social,norden.social,nrw.social
# DXMAP_MASTODON_TAGS=Rechtsextremismus,Naziaufmarsch,...
# DXMAP_GEO_COUNTRY=de

# Optional. YouTube Data API key (free tier) — activates the YouTube source.
# YOUTUBE_API_KEY=

# Optional. Reddit OAuth app credentials (free) — see backend/agent.py.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# --- Self-check (backend/selfcheck.py) ---
# DXMAP_SELFCHECK_SECONDS=900
# DXMAP_BASE_URL=http://127.0.0.1:8020
# DXMAP_DEBUG=0
