[Unit]
Description=Discrimination Map — far-right incident monitor (Germany)
After=network.target

[Service]
Type=simple
# Adjust these two if you install somewhere other than /opt/dxmap
WorkingDirectory=/opt/dxmap/backend
ExecStart=/opt/dxmap/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8020

# Run as an unprivileged service user, not root. Created by deploy.sh.
User=dxmap
Group=dxmap

# --- environment -----------------------------------------------------------
# Prefer an EnvironmentFile so secrets aren't visible in `systemctl status`.
EnvironmentFile=-/opt/dxmap/.env
Environment=DXMAP_ENV=prod
Environment=DXMAP_DB_PATH=/opt/dxmap/data/dxmap.db
Environment=DXMAP_ALLOW_ORIGINS=https://yourdomain.com

# --- reliability -------------------------------------------------------------
Restart=on-failure
RestartSec=5
# Give the process time to finish an in-flight heartbeat on shutdown.
TimeoutStopSec=20

# --- basic hardening ---------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/dxmap/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
